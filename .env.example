# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=farazul_portfolio

# Generate two independent secrets of at least 32 characters.
ANALYTICS_ADMIN_TOKEN=replace_with_a_long_random_secret_at_least_32_chars
VISITOR_HASH_SECRET=replace_with_a_different_long_random_secret_32_chars

# Leave empty when frontend and API are served from the same Render Web Service.
FRONTEND_ORIGIN=
NODE_ENV=development
PORT=3001
